package pageObject;

import org.junit.jupiter.api.Assertions;
import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.support.FindBy;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.openqa.selenium.support.ui.WebDriverWait;

import java.time.Duration;

public class InsuranceCalculatorPage extends BtlBasePage {
    public InsuranceCalculatorPage(WebDriver driver) {
        super(driver);
    }

    @FindBy(id = "BirthDate")
    private WebElement birthDateInput;

    @FindBy(xpath = "//label[contains(text(),'תלמיד ישיבה')] | //input[contains(@id,'rdb_employeType_2')] | //span[contains(text(),'תלמיד ישיבה')]")
    private WebElement yeshivaStudentRadio;

    @FindBy(xpath = "//input[contains(@id,'StartNextButton')] | //input[@value='המשך'] | //button[contains(text(),'המשך')] | //a[contains(text(),'המשך')]")
    private WebElement nextButton;

    @FindBy(xpath = "//label[contains(text(),'לא')] | //input[contains(@id,'rdb_GetNechut_1')] | //span[contains(text(),'לא')]")
    private WebElement noDisabilityRadio;

    @FindBy(xpath = "//*[contains(@id,'lblTotalHealth') or contains(@id,'HealthInsuranceAmount') or contains(text(),'דמי ביטוח בריאות')]")
    private WebElement healthInsuranceResult;

    @FindBy(xpath = "//*[contains(@id,'lblTotalSum') or contains(@id,'TotalInsurance') or contains(text(),'סך הכל')] ")
    private WebElement totalSumResult;

    @FindBy(xpath = "//*[contains(@id,'lbl_LeumiInsuranceAmount') or contains(@id,'LeumiInsuranceAmount') or contains(text(),'דמי ביטוח לאומי')] ")
    private WebElement leumiInsuranceResult;

    public void openCalculator() {
        WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(15));
        WebElement calcLink = wait.until(ExpectedConditions.elementToBeClickable(By.partialLinkText("מחשבון")));
        calcLink.click();
    }

    public void calculateYeshivaStudent(String birthDate) {
        WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(15));

        if (birthDateInput != null) {
            wait.until(ExpectedConditions.visibilityOf(birthDateInput));
            birthDateInput.clear();
            birthDateInput.sendKeys(birthDate);
        }

        if (yeshivaStudentRadio != null) {
            wait.until(ExpectedConditions.elementToBeClickable(yeshivaStudentRadio)).click();
        }

        wait.until(ExpectedConditions.elementToBeClickable(nextButton)).click();

        wait.until(ExpectedConditions.elementToBeClickable(noDisabilityRadio)).click();
        wait.until(ExpectedConditions.elementToBeClickable(nextButton)).click();
    }

    public String getLeumiInsuranceAmount() {
        WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(15));
        WebElement element = wait.until(ExpectedConditions.visibilityOf(leumiInsuranceResult));
        return element.getText();
    }

    public String getHealthInsuranceAmount() {
        WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(15));
        WebElement element = wait.until(ExpectedConditions.visibilityOf(healthInsuranceResult));
        return element.getText();
    }

    public String getTotalSum() {
        WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(15));
        WebElement element = wait.until(ExpectedConditions.visibilityOf(totalSumResult));
        return element.getText();
    }

    public void assertResults(String expectedLeumi, String expectedHealth) {
        String leumi = getLeumiInsuranceAmount();
        String health = getHealthInsuranceAmount();

        Assertions.assertTrue(leumi.contains(expectedLeumi), "דמי ביטוח לאומי לא תואמים - מצאנו: " + leumi);
        Assertions.assertTrue(health.contains(expectedHealth), "דמי ביטוח בריאות לא תואמים - מצאנו: " + health);
    }
}
